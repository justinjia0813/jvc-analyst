#!/usr/bin/env bash
# jvc-analyst setup — register skills with Claude Code / Codex / Agents / OpenClaw / Hermes / Cursor
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$SCRIPT_DIR/skills"

# User-invocable skills
USER_SKILLS=(
  jvc-deal-flow
  jvc-prescreen
  jvc-bull-case
  jvc-track-research
  jvc-research-report
  jvc-knowledge-tree-builder
  jvc-comps-dd
  jvc-market-sizing
  jvc-roi-modeler
  jvc-bear-case
  jvc-ic-memo
  jvc-meeting-notes
  jvc-talk-notes
  jvc-invoice-manager
)

SUPPORT_COMPONENTS=(
  jvc-research-core
)

ALL_COMPONENTS=("${USER_SKILLS[@]}" "${SUPPORT_COMPONENTS[@]}")

# Platform skill directories
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_SKILLS="$HOME/.codex/skills"
AGENTS_SKILLS=".agents/skills"
OPENCLAW_SKILLS=".openclaw/skills"
HERMES_SKILLS=".hermes/skills"
CURSOR_SKILLS=".cursor/skills"

# ─── Helpers ──────────────────────────────────────────────────

_link_or_copy() {
  local src="$1"
  local dst="$2"
  local target_parent
  local target_name
  local stage_dir
  local prepared
  local backup_dir=""
  local platform

  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    return 0
  fi

  platform="$(uname -s)"
  case "$platform" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
      if [ -d "$dst" ] && [ ! -L "$dst" ] && diff -qr -- "$src" "$dst" >/dev/null 2>&1; then
        return 0
      fi
      ;;
  esac

  target_parent="$(dirname "$dst")"
  target_name="$(basename "$dst")"
  stage_dir="$(mktemp -d "$target_parent/.${target_name}.stage.XXXXXX")"
  prepared="$stage_dir/replacement"

  case "$platform" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
      if ! cp -R "$src" "$prepared"; then
        rm -rf -- "$stage_dir"
        return 1
      fi
      ;;
    *)
      if ! ln -s "$src" "$prepared"; then
        rm -rf -- "$stage_dir"
        return 1
      fi
      ;;
  esac

  if [ -e "$dst" ] || [ -L "$dst" ]; then
    backup_dir="$(mktemp -d "${dst}.backup.XXXXXX")"
    if ! mv "$dst" "$backup_dir/original"; then
      rmdir "$backup_dir"
      rm -rf -- "$stage_dir"
      return 1
    fi
    # ponytail: retain each replaced real-directory backup; clean only after user confirmation.
    echo "  backup: $backup_dir/original"
  fi

  if mv "$prepared" "$dst"; then
    rmdir "$stage_dir"
    return 0
  fi

  echo "  ERROR failed to publish $dst" >&2
  if [ -n "$backup_dir" ] && { [ -e "$backup_dir/original" ] || [ -L "$backup_dir/original" ]; }; then
    if mv "$backup_dir/original" "$dst"; then
      rmdir "$backup_dir"
    else
      echo "  ERROR failed to restore backup from $backup_dir/original" >&2
    fi
  fi
  rm -rf -- "$stage_dir"
  return 1
}

register_skill() {
  local skill_name="$1"
  local target_dir="$2"
  local src="$SKILLS_DIR/$skill_name"

  mkdir -p "$target_dir"
  _link_or_copy "$src" "$target_dir/$skill_name"
}

# ─── Main ─────────────────────────────────────────────────────

for component in "${ALL_COMPONENTS[@]}"; do
  if [ ! -d "$SKILLS_DIR/$component" ]; then
    echo "ERROR missing source component: $SKILLS_DIR/$component" >&2
    exit 1
  fi
done

echo "jvc-analyst skill installer"
echo "==========================="
echo ""
echo "Source: $SKILLS_DIR"
echo "Skills: ${#USER_SKILLS[@]} user skills"
echo "Support: ${#SUPPORT_COMPONENTS[@]} hidden component"
echo ""

# Detect which platforms exist
INSTALLED=0

# Claude Code (global)
if [ -d "$CLAUDE_SKILLS" ] || command -v claude >/dev/null 2>&1; then
  echo "→ Claude Code ($CLAUDE_SKILLS)"
  mkdir -p "$CLAUDE_SKILLS"
  for skill in "${ALL_COMPONENTS[@]}"; do
    register_skill "$skill" "$CLAUDE_SKILLS"
  done
  echo "  ✓ ${#ALL_COMPONENTS[@]} components registered"
  INSTALLED=1
fi

# Codex (global)
if [ -d "$HOME/.codex" ]; then
  echo "→ Codex ($CODEX_SKILLS)"
  mkdir -p "$CODEX_SKILLS"
  for skill in "${ALL_COMPONENTS[@]}"; do
    register_skill "$skill" "$CODEX_SKILLS"
  done
  echo "  ✓ ${#ALL_COMPONENTS[@]} components registered"
  INSTALLED=1
fi

# Project-local platforms (only if in a git repo)
if git rev-parse --show-toplevel >/dev/null 2>&1; then
  REPO_ROOT="$(git rev-parse --show-toplevel)"

  for platform_dir in "$AGENTS_SKILLS" "$OPENCLAW_SKILLS" "$HERMES_SKILLS" "$CURSOR_SKILLS"; do
    full_path="$REPO_ROOT/$platform_dir"
    parent_dir="$(dirname "$full_path")"

    # Only register if the platform directory parent exists (user has that tool)
    if [ -d "$parent_dir" ]; then
      echo "→ $(basename "$parent_dir") ($full_path)"
      mkdir -p "$full_path"
      for skill in "${ALL_COMPONENTS[@]}"; do
        register_skill "$skill" "$full_path"
      done
      echo "  ✓ ${#ALL_COMPONENTS[@]} components registered"
      INSTALLED=1
    fi
  done
fi

echo ""

if [ "$INSTALLED" -eq 0 ]; then
  echo "No supported platforms detected."
  echo ""
  echo "Manual install: copy or symlink skills/* to your platform's skill directory:"
  echo "  Claude Code:  ~/.claude/skills/"
  echo "  Codex:        ~/.codex/skills/"
  echo "  Agents:       .agents/skills/"
  echo "  OpenClaw:     .openclaw/skills/"
  echo "  Hermes:       .hermes/skills/"
  echo "  Cursor:       .cursor/skills/"
  exit 1
fi

echo "Done. Available skills:"
for skill in "${USER_SKILLS[@]}"; do
  echo "  /${skill}"
done
echo ""
echo "Try: /jvc-prescreen with a deck to get started."
