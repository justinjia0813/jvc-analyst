{
  "optimizer_hints": {
    "capability": "Validate and render completed fixed-format local industry research as branded PDF and HTML without rewriting content",
    "inputs": ["fixed-format report.md", "brand.yml", "local images"],
    "trigger_actions": ["validate completed research", "render a branded report", "rebuild local report outputs"],
    "exclusions": ["first-pass research", "arbitrary Markdown conversion", "content rewriting", "investment-committee memo drafting"],
    "artifacts": ["report.pdf", "report.html", "build-report.txt"]
  },
  "fallback_positive_concepts": ["fixed_input", "render_report"],
